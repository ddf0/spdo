repeat while (Значения корректны?) is (нет) not (да)
:Сохранить параметры;
:Записать изменение в журнал;
if (Изменена модель?) then (да)
  :Предложить повторное
  построение индекса (ТЗ.Ф22);
else (нет)
endif
:Применять новые значения
к последующим сеансам поиска;
stop
