@startuml
!include style.iuml
title Модель классов предметной области СПДО
hide circle
skinparam classAttributeIconSize 0

enum СтатусОбращения {
  Новое
  В_работе
  Решено
  Закрыто
  Закрыто_как_дубликат
}
enum ВидСвязи {
  Дубликат
  Связанное
}
enum Вердикт {
  Не_рассмотрена
  Принята
  Отклонена
}
enum Роль {
  Пользователь
  Оператор
  Администратор
}

class Пользователь {
  +идентификатор
  +имя
  +роль : Роль
  +хешПароля
}

class Обращение {
  +идентификатор
  +заголовок
  +описание
  +статус : СтатусОбращения
  +конфиденциальное : логическое
  +датаРегистрации
  +датаИзменения
  +векторноеПредставление
}

class Категория {
  +идентификатор
  +наименование
  +описание
}

class Компонент {
  +идентификатор
  +наименование
}

class Связь {
  +идентификатор
  +видСвязи : ВидСвязи
  +датаУстановления
}

class СеансПоиска {
  +идентификатор
  +текстЗапроса
  +дата
  +режим
  +версияМодели
  +параметры (P1, P2, w1..w4, N)
}

class Рекомендация {
  +идентификатор
  +позиция
  +коэффициентСходства : число [0..1]
  +составляющие (S_сем, S_лекс, S_кат, S_комп)
  +предложенныйВид : ВидСвязи
  +объяснение
  +вердикт : Вердикт
  +датаВердикта
}

class ОценкаРешения {
  +идентификатор
  +помогло : логическое
  +дата
}

class ИсторияИзменений {
  +идентификатор
  +видИзменения
  +прежнееЗначение
  +новоеЗначение
  +комментарий
  +дата
}

class Решение {
  +идентификатор
  +текстРешения
  +дата
}

class ПараметрыПоиска {
  +порогДубликата P1
  +порогСвязанного P2
  +числоРезультатов N
  +веса w1..w4
  +идентификаторМодели
}

Пользователь "1" -- "0..*" Обращение : автор >
Пользователь "1" -- "0..*" Связь : установил >
Пользователь "1" -- "0..*" Решение : автор >
Категория "1" -- "0..*" Обращение
Компонент "1" -- "0..*" Обращение
Обращение "1" -- "0..1" Решение
Обращение "1" -- "0..*" Связь : источник
Обращение "1" -- "0..*" Связь : цель
Обращение "0..1" -- "0..*" СеансПоиска : запрос
СеансПоиска "1" *-- "0..*" Рекомендация
Обращение "1" -- "0..*" Рекомендация : кандидат
Рекомендация "0..1" -- "0..1" Связь : порождает >
Обращение "0..*" -- "0..1" Обращение : основное
Решение "1" -- "0..*" ОценкаРешения
Пользователь "1" -- "0..*" ОценкаРешения
Обращение "1" *-- "0..*" ИсторияИзменений
Пользователь "1" -- "0..*" ИсторияИзменений : автор >
@enduml
