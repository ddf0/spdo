@startuml
!include style.iuml
left to right direction
title Диаграмма прецедентов СПДО (базовая)

actor "Пользователь" as U
actor "Оператор\nтехнической поддержки" as O
actor "Администратор" as A
actor "Модуль\nсемантического поиска" as M <<система>>

rectangle "Система интеллектуального поиска дубликатов обращений" {
  usecase "ПЦ1 Зарегистрировать\nобращение" as UC1
  usecase "ПЦ2 Подобрать похожие\nобращения" as UC2
  usecase "ПЦ3 Просмотреть найденное\nобращение и его решение" as UC3
  usecase "ПЦ4 Пометить обращение\nкак дубликат" as UC4
  usecase "ПЦ5 Связать обращения как\nтематически близкие" as UC5
  usecase "ПЦ6 Отклонить\nрекомендацию" as UC6
  usecase "ПЦ7 Обработать обращение\nи опубликовать решение" as UC7
  usecase "ПЦ8 Вести реестр\nобращений" as UC8
  usecase "ПЦ9 Просмотреть статистику\nкачества рекомендаций" as UC9
  usecase "ПЦ10 Настроить\nпараметры поиска" as UC10
  usecase "ПЦ11 Войти в систему" as UC11
  usecase "ПЦ12 Оценить полезность\nрешения" as UC12
}

U --> UC1
U --> UC3
U --> UC4
U --> UC6
U --> UC11
U --> UC12

O --> UC4
O --> UC5
O --> UC6
O --> UC7
O --> UC8
O --> UC11

A --> UC9
A --> UC10
A --> UC11

UC2 --> M
@enduml
